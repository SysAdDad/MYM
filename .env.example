# The default listener is local to the Docker host.
SIGNATURE_BIND_IP=127.0.0.1
SIGNATURE_BIND_PORT=8080

# False supports initial setup at http://localhost:8080.
# Use true behind an HTTPS proxy before enabling OIDC or LDAP.
COOKIE_SECURE=false

# Optional. Leave blank to generate a persistent random key in the data volume.
SESSION_SECRET=

# Optional HTTPS image origin, without a path or query string.
PUBLIC_BASE_URL=

# Optional bootstrap credentials for unattended installs.
# Leave blank to use first-run setup and choose your own administrator.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Optional environment defaults. Use Admin settings for normal configuration.
# OIDC requires COOKIE_SECURE=true. Use the exact discovery issuer and callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_AUTO_PROVISION=false
